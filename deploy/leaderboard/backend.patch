+    def save_evaluation(self, identifier: str, value: dict) -> dict:
+        """Record one immutable result; read eligibility and provenance in the same transaction."""
+        from .leaderboard import result_for_run, validate_evaluation
+        evaluation = validate_evaluation(value)
+        encoded = encode(evaluation)
+        with self.transaction() as database:
+            existing = database.execute("SELECT evaluation,result FROM evaluations WHERE run_id=? AND benchmark=?",
+                                        (identifier, evaluation["benchmark"])).fetchone()
+            if existing is not None:
+                if existing["evaluation"] != encoded:
+                    raise errors.ArenaError("EVALUATION_CONFLICT", "Run already has a different immutable evaluation for this benchmark", 409)
+                return json.loads(existing["result"])
+            row = database.execute("SELECT spec,record FROM runs WHERE id=?", (identifier,)).fetchone()
+            if row is None:
+                raise KeyError(identifier)
+            run = json.loads(row["record"])
+            run["spec"] = json.loads(row["spec"])
+            row = database.execute("SELECT spec,state,owner,report FROM submissions WHERE id=?",
+                                   (run["spec"]["submission_id"],)).fetchone()
+            if row is None:
+                raise KeyError(run["spec"]["submission_id"])
+            submission = {"spec": json.loads(row["spec"]), "report": json.loads(row["report"]),
+                          "state": row["state"], "owner": row["owner"]}
+            result = result_for_run(run, submission, evaluation)
+            database.execute("INSERT INTO evaluations VALUES (?,?,?,?,?)",
+                             (identifier, evaluation["benchmark"], encoded, encode(result), time.time()))
+            return result
+
+    def evaluations(self, benchmark: str) -> list[dict]:
+        return self.evaluation_snapshot(benchmark)[1]
+
+    def evaluation_snapshot(self, benchmark: str, snapshot: int | None = None) -> tuple[int, list[dict]]:
+        """Freeze the append-only history so every leaderboard page sees the same results."""
+        with self.transaction() as database:
+            latest = database.execute("SELECT COALESCE(MAX(rowid),0) FROM evaluations").fetchone()[0]
+            if snapshot is None:
+                snapshot = latest
+            elif type(snapshot) is not int or not 0 <= snapshot <= latest:
+                raise ValueError("Leaderboard cursor names an unavailable snapshot")
+            rows = database.execute("SELECT result FROM evaluations WHERE benchmark=? AND rowid<=? ORDER BY created_at,rowid",
+                                    (benchmark, snapshot)).fetchall()
+        return snapshot, [json.loads(row["result"]) for row in rows]
+
