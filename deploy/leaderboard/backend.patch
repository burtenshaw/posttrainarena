+def test_pages_continue_until_both_collections_exhausted(state):
+    for index in range(51):
+        identifier = completed_run(state, f"submission-{index}")
+        state.save_evaluation(identifier, evaluation())
+    controller = Controller.__new__(Controller)
+    controller.state = state
+    first = controller.leaderboard()
+    assert len(first["entries"]) == 1 and len(first["runs"]) == 50
+    second = controller.leaderboard(first["next_cursor"])
+    assert second["entries"] == [] and len(second["runs"]) == 1
+    assert second["next_cursor"] is None
