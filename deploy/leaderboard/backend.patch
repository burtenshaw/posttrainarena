+++ b/tests/test_leaderboard.py
@@ -0,0 +1,288 @@
+import hashlib
+import json
+import threading
+import urllib.error
+import urllib.request
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from posttrain_infra.bridge import PUBLIC_ROUTES, forward
+from posttrain_infra.controller import Controller
+from posttrain_infra.errors import ArenaError
+from posttrain_infra.leaderboard import BENCHMARK, DOMAIN_IDS, leaderboard, validate_evaluation
+from posttrain_infra.server import create_server
+from posttrain_infra.state import State, encode
+from posttrain_infra.runtime import MAX_RPC_BYTES, encode_json
+
+
+def evaluation(default=0, **overrides):
+    return {"benchmark": BENCHMARK, "scores": {
+        domain: {"solved": overrides.get(domain, default), "total": 5} for domain in DOMAIN_IDS}}
+
+
+def completed_run(store, identifier="submission-one", user="alice", name="Training environment", **changes):
+    submission = {"submission_id": identifier, "name": name,
+                  "dataset": {"repo": f"{user}/{identifier}", "revision": "a" * 40},
+                  "tasks": [{"task_id": "private-task-must-not-appear", "split": "train"},
+                            {"task_id": "private-evaluation-task", "split": "eval"}]}
+    store.save_submission(submission, {"admissible": True}, "validated", f"space:{user}")
+    run, _ = store.create_run({"submission_id": identifier, "provider": "slurm"}, "slurm", f"space:{user}")
+    store.update(run["run_id"], lambda record: record.update(
+        {"state": "completed", "policy_version": 1, "checkpoint": {"key": "committed", "sha256": "b" * 64}, **changes}))
+    return run["run_id"]
+
+
+@pytest.fixture
+def state(tmp_path):
+    return State(str(tmp_path / "arena.db"))
+
+
+def test_durable_per_user_domain_maxima_and_winning_datasets(state):
+    first = completed_run(state)
+    second = completed_run(state, "submission-two")
+    lower = completed_run(state, "submission-three")
+    bob = completed_run(state, "submission-bob", "bob")
+    state.save_evaluation(first, evaluation(**{DOMAIN_IDS[0]: 5, DOMAIN_IDS[1]: 1}))
+    state.save_evaluation(second, evaluation(**{DOMAIN_IDS[0]: 2, DOMAIN_IDS[1]: 4}))
+    state.save_evaluation(lower, evaluation(0))
+    state.save_evaluation(bob, evaluation(1))
+    reopened = State(state.path)
+    board = leaderboard(reopened.evaluations(BENCHMARK))
+    alice = board["entries"][0]
+    assert alice["user"] == "alice"
+    assert alice["runs"] == 3
+    assert alice["average"] == pytest.approx((1 + .8) / 8)
+    assert alice["scores"][DOMAIN_IDS[0]]["run_id"] == first
+    assert alice["scores"][DOMAIN_IDS[1]]["run_id"] == second
+    assert alice["scores"][DOMAIN_IDS[0]]["dataset"]["repo"] == "alice/submission-one"
+    assert alice["scores"][DOMAIN_IDS[1]]["dataset"]["repo"] == "alice/submission-two"
+    assert alice["scores"][DOMAIN_IDS[1]]["dataset"]["url"].endswith("/tree/" + "a" * 40)
+    assert len(board["runs"]) == 4
+    assert board["runs"][0]["tasks"] == 1
+    assert board["runs"][0]["solved"] == 6
+    assert board["runs"][0]["total"] == 40
+    assert "private-task" not in json.dumps(board)
+    assert "private-evaluation" not in json.dumps(board)
+    assert "checkpoint" not in json.dumps(board)
+
+
+def test_idempotent_atomic_replay_and_conflict(state):
+    identifier = completed_run(state)
+    value = evaluation(2)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(lambda _: state.save_evaluation(identifier, value), range(2)))
+    assert results[0] == results[1]
+    assert len(State(state.path).evaluations(BENCHMARK)) == 1
+    with pytest.raises(ArenaError) as raised:
+        state.save_evaluation(identifier, evaluation(3))
+    assert raised.value.status == 409
+    assert raised.value.code == "EVALUATION_CONFLICT"
+    assert state.evaluations(BENCHMARK)[0] == results[0]
+
+
+def test_stable_ties_and_current_benchmark_only(state):
+    bob = completed_run(state, "bob-one", "bob")
+    alice = completed_run(state)
+    alice_again = completed_run(state, "alice-two")
+    state.save_evaluation(bob, evaluation(**{DOMAIN_IDS[0]: 5, DOMAIN_IDS[1]: 3}))
+    for identifier in (alice, alice_again):
+        state.save_evaluation(identifier, evaluation(1))
+    with state.transaction() as database:
+        database.execute("INSERT INTO evaluations VALUES (?,?,?,?,?)", (
+            "historical", "retired", "{}", encode({"benchmark": "retired", "private": "old"}), 0))
+    board = leaderboard(state.evaluations(BENCHMARK))
+    assert [entry["user"] for entry in board["entries"]] == ["alice", "bob"]
+    assert all(score["run_id"] == alice for score in board["entries"][0]["scores"].values())
+    assert len(board["runs"]) == 3
+    assert len(state.evaluations("retired")) == 1
+
+
+@pytest.mark.parametrize("change", [
+    lambda value: value.update(user="mallory"),
+    lambda value: value.update(dataset={"repo": "mallory/forged", "revision": "a" * 40}),
+    lambda value: value.update(benchmark="other"),
+    lambda value: value["scores"].pop(DOMAIN_IDS[0]),
+    lambda value: value["scores"].update(unknown={"solved": 0, "total": 5}),
+    lambda value: value["scores"][DOMAIN_IDS[0]].update(total=4),
+    lambda value: value["scores"][DOMAIN_IDS[0]].update(solved=6),
+    lambda value: value["scores"][DOMAIN_IDS[0]].update(solved=-1),
+    lambda value: value["scores"][DOMAIN_IDS[0]].update(solved=True),
+    lambda value: value["scores"][DOMAIN_IDS[0]].update(solved=1.0),
+    lambda value: value["scores"][DOMAIN_IDS[0]].update(tasks=["secret"]),
+])
+def test_only_complete_aggregate_evaluations_allowed(change):
+    value = evaluation()
+    change(value)
+    with pytest.raises(ValueError):
+        validate_evaluation(value)
+
+
+@pytest.mark.parametrize("changes", [
+    {"state": "failed"}, {"state": "running"}, {"state": "cleanup"}, {"node": "simulated"},
+    {"simulated": True}, {"simulation": True}, {"dry_run": True}, {"checkpoint": None},
+    {"policy_version": 0}, {"error": "failed"}, {"error_code": "CLEANUP_FORCE_RELEASED"},
+    {"owner": "space:mallory"}, {"owner": "local"},
+])
+def test_unrankable_runs_rejected(state, changes):
+    identifier = completed_run(state, **changes)
+    with pytest.raises(ArenaError, match="Evaluation requires"):
+        state.save_evaluation(identifier, evaluation())
+    assert not state.evaluations(BENCHMARK)
+
+
+def test_missing_pinned_dataset_is_clear_error(state):
+    identifier = completed_run(state)
+    with state.transaction() as database:
+        row = database.execute("SELECT spec FROM submissions").fetchone()
+        spec = json.loads(row[0])
+        spec.pop("dataset")
+        database.execute("UPDATE submissions SET spec=?", (encode(spec),))
+    with pytest.raises(ArenaError) as raised:
+        state.save_evaluation(identifier, evaluation())
+    assert raised.value.code == "EVALUATION_DATASET_REQUIRED"
+    assert raised.value.status == 409
+
+
+def test_provenance_uses_immutable_run_spec(state):
+    identifier = completed_run(state)
+    completed_run(state, "different-dataset")
+    state.update(identifier, lambda record: record["spec"].update(submission_id="different-dataset"))
+    result = state.save_evaluation(identifier, evaluation())
+    assert result["submission_id"] == "submission-one"
+    assert result["dataset"]["repo"] == "alice/submission-one"
+
+
+def test_unadmitted_submission_is_not_ranked(state):
+    identifier = completed_run(state)
+    original = state.submission("submission-one")
+    state.save_submission(original["spec"], {"admissible": False}, "rejected", original["owner"])
+    with pytest.raises(ArenaError, match="admitted submission"):
+        state.save_evaluation(identifier, evaluation())
+
+
+@pytest.fixture
+def api(state, tmp_path):
+    controller = Controller.__new__(Controller)
+    controller.state = state
+    controller.config = {"transfer_directory": str(tmp_path / "transfers"), "client_tokens": {
+        hashlib.sha256(token.encode()).hexdigest(): {"subject": subject, "roles": roles}
+        for token, subject, roles in [("participant-token", "alice", ["user"]),
+                                      ("read-token", "reader", ["read"]),
+                                      ("delegate-token", "space", ["delegate"]),
+                                      ("submit-token", "submitter", ["submit"])]}}
+    server = create_server(controller, port=0, api_token="admin-token")
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+
+    def request(method, path, value=None, token=None, subject=None):
+        headers = {"Content-Type": "application/json"}
+        if token:
+            headers["Authorization"] = f"Bearer {token}"
+        if subject:
+            headers["X-Arena-Subject"] = subject
+        body = None if value is None else json.dumps(value).encode()
+        req = urllib.request.Request(f"http://127.0.0.1:{server.server_port}{path}", data=body, headers=headers, method=method)
+        try:
+            response = urllib.request.urlopen(req)
+        except urllib.error.HTTPError as error:
+            response = error
+        with response:
+            return response.status, json.load(response)
+
+    yield request
+    server.shutdown()
+    server.server_close()
+    thread.join()
+
+
+def test_http_admin_only_write_read_roles_and_conflict(api, state):
+    identifier = completed_run(state)
+    path = f"/runs/{identifier}/evaluation"
+    assert api("POST", path, evaluation())[0] == 401
+    assert api("POST", path, evaluation(), "participant-token")[0] == 403
+    assert api("POST", path, evaluation(), "read-token")[0] == 403
+    assert api("POST", path, evaluation(), "delegate-token", "alice")[0] == 403
+    assert not state.evaluations(BENCHMARK)
+    assert api("POST", path, evaluation(1), "admin-token")[0] == 200
+    assert api("POST", path, evaluation(1), "admin-token")[0] == 200
