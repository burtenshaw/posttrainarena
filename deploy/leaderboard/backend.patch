+def test_http_pages_149_users_below_rpc_limit_and_freezes_snapshot(api, state):
+    users = [f"u{index:03}" + "x" * 60 for index in range(149)]
+    for index, user in enumerate(users):
+        identifier = completed_run(state, "s" + "x" * 92 + f"{index:03}", user, name="雪" * 256)
+        state.save_evaluation(identifier, evaluation(index % 5))
+    expected = leaderboard(state.evaluations(BENCHMARK))
+    status, page = api("GET", "/leaderboard", token="read-token")
+    assert status == 200
+    assert page["next_cursor"] == "149-50"
+    # This would change both ranking and a user's maxima if later pages reread live history.
+    new_run = completed_run(state, "new-winner", users[-1])
+    state.save_evaluation(new_run, evaluation(5))
+    entries, runs, lengths = [], [], []
+    while True:
+        assert len(encode_json(page)) < MAX_RPC_BYTES
+        assert len(page["entries"]) <= 50 and len(page["runs"]) <= 50
+        assert page["benchmark"] == BENCHMARK
+        lengths.append((len(page["entries"]), len(page["runs"])))
+        entries.extend(page["entries"])
+        runs.extend(page["runs"])
+        if page["next_cursor"] is None:
+            break
+        status, page = api("GET", "/leaderboard/" + page["next_cursor"], token="read-token")
+        assert status == 200
+    assert lengths == [(50, 50), (50, 50), (49, 49)]
+    assert entries == expected["entries"]
+    assert runs == expected["runs"]
+    assert new_run not in {run["run_id"] for run in runs}
+    status, fresh = api("GET", "/leaderboard", token="read-token")
+    assert status == 200
+    assert fresh["next_cursor"] == "150-50"
+    assert fresh["entries"][0]["user"] == users[-1]
+
