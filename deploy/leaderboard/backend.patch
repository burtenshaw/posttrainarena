index 0000000..7aa013f
--- /dev/null
+++ b/src/posttrain_infra/leaderboard.py
@@ -0,0 +1,94 @@
+"""Public held-out results, with provenance derived from Arena's stored records."""
+from __future__ import annotations
+
+import re
+
+from . import errors
+from .contracts import parse_dataset_name
+
+BENCHMARK = "heldout-v1"
+TASKS_PER_DOMAIN = 5
+PAGE_SIZE = 50
+CURSOR_PATTERN = r"(?:0|[1-9][0-9]{0,18})-(?:0|[1-9][0-9]{0,18})"
+DOMAINS = [
+    {"id": "software-engineering", "name": "Software engineering", "short": "Software"},
+    {"id": "industrial-physical-systems", "name": "Industrial & physical systems", "short": "Industrial"},
+    {"id": "natural-science", "name": "Natural science", "short": "Science"},
+    {"id": "office-white-collar", "name": "Office & white-collar", "short": "Office"},
+    {"id": "finance-economics", "name": "Finance & economics", "short": "Finance"},
+    {"id": "mathematics-or-formal-reasoning", "name": "Math & formal reasoning", "short": "Math"},
+    {"id": "cybersecurity", "name": "Cybersecurity", "short": "Security"},
+    {"id": "media-content-production", "name": "Media & content production", "short": "Media"},
+]
+DOMAIN_IDS = tuple(domain["id"] for domain in DOMAINS)
+
+
+def validate_evaluation(value: dict) -> dict:
+    """Accept a complete aggregate result only; task contents never enter this API."""
+    if type(value) is not dict or set(value) != {"benchmark", "scores"}:
+        raise ValueError("An evaluation contains only benchmark and scores")
+    if value["benchmark"] != BENCHMARK:
+        raise ValueError(f"benchmark must be {BENCHMARK}")
+    scores = value["scores"]
+    if type(scores) is not dict or set(scores) != set(DOMAIN_IDS):
+        raise ValueError("Evaluation requires all eight benchmark domains exactly once")
+    for score in scores.values():
+        if (type(score) is not dict or set(score) != {"solved", "total"}
+                or type(score["solved"]) is not int or type(score["total"]) is not int
+                or score["total"] != TASKS_PER_DOMAIN or not 0 <= score["solved"] <= TASKS_PER_DOMAIN):
+            raise ValueError("Each domain requires integer solved in [0, 5] and total=5")
+    return {"benchmark": BENCHMARK, "scores": {domain: dict(scores[domain]) for domain in DOMAIN_IDS}}
+
+
+def result_for_run(run: dict, submission: dict, evaluation: dict) -> dict:
+    """Bind an operator result to the completed run and its immutable submitted dataset."""
+    spec = run["spec"]
+    if (run.get("state") != "completed" or run.get("node") != "slurm" or spec.get("provider") != "slurm"
+            or type(run.get("policy_version")) is not int or run["policy_version"] < 1
+            or not run.get("checkpoint") or run.get("error") or run.get("error_code")
+            or any(record.get(flag) for record in (run, spec) for flag in ("simulated", "simulation", "dry_run"))):
+        raise errors.ArenaError("EVALUATION_RUN_INELIGIBLE", "Evaluation requires a completed real training run with a committed checkpoint", 409)
+    owner = run.get("owner", "")
+    if (not re.fullmatch(r"space:[A-Za-z0-9][A-Za-z0-9_-]{0,63}", owner)
+            or submission.get("owner") != owner or submission.get("state") != "validated"
+            or submission.get("report", {}).get("admissible") is not True):
+        raise errors.ArenaError("EVALUATION_RUN_INELIGIBLE", "Evaluation requires an admitted submission owned by the run's verified Hugging Face user", 409)
+    submitted = submission["spec"]
+    if submitted.get("submission_id") != spec.get("submission_id"):
+        raise errors.ArenaError("EVALUATION_RUN_INELIGIBLE", "Run and submission identities differ", 409)
+    dataset = submitted.get("dataset")
+    if (type(dataset) is not dict or set(dataset) != {"repo", "revision"}
+            or type(dataset.get("revision")) is not str or not re.fullmatch(r"[a-f0-9]{40}", dataset["revision"])):
+        raise errors.ArenaError("EVALUATION_DATASET_REQUIRED", "A pinned Hugging Face dataset is required to rank this run", 409)
+    repo = parse_dataset_name(dataset["repo"])
+    dataset = {**dataset, "url": f"https://huggingface.co/datasets/{repo}/tree/{dataset['revision']}"}
+    return {"benchmark": evaluation["benchmark"], "run_id": run["run_id"], "user": owner[6:],
+            "submission_id": submitted["submission_id"], "name": errors.sanitize(submitted.get("name", ""), 256),
+            "tasks": sum(task.get("split") == "train" for task in submitted.get("tasks", [])),
+            "dataset": dataset, "scores": evaluation["scores"]}
+
+
+def leaderboard(results: list[dict]) -> dict:
+    """Each user's best result per domain; equal scores keep the first recorded winner."""
+    entries, runs = {}, []
+    for result in results:
+        if result["benchmark"] != BENCHMARK:
+            continue
+        user = result["user"]
+        entry = entries.setdefault(user, {"user": user, "runs": 0, "scores": {}})
+        entry["runs"] += 1
+        scores = {domain: {**score, "score": score["solved"] / score["total"]}
+                  for domain, score in result["scores"].items()}
+        runs.append({**result, "scores": scores, "solved": sum(score["solved"] for score in scores.values()),
+                     "total": len(DOMAIN_IDS) * TASKS_PER_DOMAIN})
+        for domain, score in scores.items():
+            previous = entry["scores"].get(domain)
+            if previous is None or score["score"] > previous["score"]:
+                entry["scores"][domain] = {**score, "run_id": result["run_id"],
+                    "submission_id": result["submission_id"], "dataset": dict(result["dataset"])}
+    for entry in entries.values():
+        entry["average"] = sum(entry["scores"][domain]["solved"] for domain in DOMAIN_IDS) / (len(DOMAIN_IDS) * TASKS_PER_DOMAIN)
+    return {"benchmark": BENCHMARK, "tasks_per_domain": TASKS_PER_DOMAIN,
+            "domains": [dict(domain) for domain in DOMAINS],
+            "entries": sorted(entries.values(), key=lambda entry: (-entry["average"], entry["user"].casefold(), entry["user"])),
+            "runs": runs}
