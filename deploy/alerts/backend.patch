+"""CPU-only regression coverage for persisted run alerts and delivery recovery."""
+import json
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+from urllib.parse import parse_qs, urlsplit
+
+from posttrain_infra import errors
+from posttrain_infra.controller import Controller
+from posttrain_infra.state import State
+
+
+class AlertTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.token = self.root / "ingest-token"
+        self.token.write_text("dedicated-ingestion-secret")
+        self.config = {
+            "slurm": {"partition": "gpu", "gpu_type": "h200", "shared_directory": str(self.root)},
+            "controller_url": "https://controller.example",
+            "trackio": {"url": "https://metrics.hf.space", "token_file": str(self.token)},
+        }
+        self.state = State(str(self.root / "state.sqlite"))
+        self.owner = "space:burtenshaw"
+        self.submission = {
+            "submission_id": "sql-investigation-v1", "images": [],
+            "tasks": [{"task_id": "train-one", "split": "train"},
+                      {"task_id": "held-out", "split": "test"}],
+        }
+        self.state.save_submission(self.submission, {}, "validated", self.owner, queue_run=True)
+        self.controller = self.make_controller()
+        self.record, self.run_token = self.state.create_run({
+            "submission_id": self.submission["submission_id"], "num_updates": 1000,
+            "model_id": "Qwen/Qwen3.5-9B", "model_revision": "a" * 40,
+            "recipe": "grpo", "private_extra": "never-forward-this",
+        }, "slurm", self.owner)
+        self.run_id = self.record["run_id"]
+        self.state.settle_run(self.submission["submission_id"], run_id=self.run_id)
+        self.state.update(self.run_id, lambda record: record.update(
+            state="ready", policy_version=39, checkpoint={"manifest": "durable-checkpoint"}))
+
+    def make_controller(self, **updates):
+        controller = Controller(self.state, {**self.config, **updates})
+        self.addCleanup(controller.validation_executor.shutdown)
+        self.addCleanup(controller.run_executor.shutdown)
+        self.addCleanup(controller.alert_executor.shutdown)
+        return controller
+
+    def summary(self):
+        return self.controller.list_submissions(self.owner)[0]["run"]
+
+    def fail(self):
+        return self.controller.fail(self.run_id, "Sandbox cleanup timed out", errors.INFRASTRUCTURE_FAILURE)
+
+    def retry(self, stopped=True):
+        record = self.state.run(self.run_id)
+        group = {"epoch": record["epoch"], "stopped": ["env-0"] if stopped else [],
+                 "remote_sessions": {"env-0": "session-0"}}
+        self.state.update(self.run_id, lambda current: current.update(state="rolling", group=group))
+        return self.controller.retry_group(self.run_id, group["epoch"], "Verifier transport failed")
+
+    def test_failure_explains_checkpoint_and_only_links_after_delivery(self):
+        run = self.fail()
+        self.assertEqual(run["state"], "cleanup")
+        self.assertEqual(run["policy_version"], 39)
+        summary = self.summary()
+        self.assertTrue(summary["checkpoint_available"])
+        self.assertIn("Checkpoint at step 39 is retained", summary["alert"]["message"])
+        self.assertIsNone(summary["alert"]["url"])
+        with patch("posttrain_infra.controller.post_alert") as send:
+            self.controller._deliver_alerts()
+        send.assert_called_once()
+        alert_url = urlsplit(self.summary()["alert"]["url"])
+        self.assertEqual(alert_url.path, "/reports")
+        self.assertEqual(parse_qs(alert_url.query), {"project": ["burtenshaw"], "runs": [self.run_id]})
+        self.assertEqual(self.state.pending_alerts(), [])
+        self.state.update(self.run_id, lambda current: current.update(state="completed", error=None))
+        self.assertEqual(self.summary()["alert"]["url"], alert_url.geturl())
+
+    def test_retry_discards_unverified_work_without_advancing_optimizer(self):
+        result = self.retry()
+        self.assertEqual(result["state"], "ready")
+        self.assertEqual(result["policy_version"], 39)
+        self.assertEqual(result["group_retries"], 1)
+        self.assertIsNone(self.state.run(self.run_id)["group"])
+        self.assertIn("unverified rollout was discarded", self.summary()["alert"]["message"])
+        self.assertIn("No optimizer update", self.summary()["alert"]["message"])
+        self.assertEqual(len(self.state.pending_alerts()), 1)
+
+    def test_retry_requires_confirmed_sandbox_cleanup(self):
+        with self.assertRaises(errors.ArenaError):
+            self.retry(stopped=False)
+        self.assertEqual(self.state.run(self.run_id)["state"], "rolling")
+        self.assertEqual(self.state.pending_alerts(), [])
+
+    def test_run_failure_and_outbox_commit_atomically(self):
+        before = self.state.run(self.run_id)
+        with self.state.transaction() as database:
+            database.execute("CREATE TRIGGER reject_alert BEFORE INSERT ON run_alerts "
+                             "BEGIN SELECT RAISE(FAIL, 'simulated storage failure'); END")
+        with self.assertRaises(sqlite3.IntegrityError):
+            self.fail()
+        self.assertEqual(self.state.run(self.run_id), before)
+        self.assertEqual(self.state.pending_alerts(), [])
+
+    def test_delivery_failure_retries_same_id_after_restart_without_blocking_run(self):
+        self.fail()
+        alert_id = self.state.pending_alerts()[0]["alert"]["alert_id"]
+        with patch("posttrain_infra.state.time.time", return_value=1000), \
+                patch("posttrain_infra.controller.post_alert", side_effect=TimeoutError("private-secret")), \
+                self.assertLogs("posttrain_infra.controller", level="WARNING") as logs:
+            self.controller._deliver_alerts()
+            self.assertEqual(self.state.pending_alerts(), [])
+        self.assertNotIn("private-secret", " ".join(logs.output))
