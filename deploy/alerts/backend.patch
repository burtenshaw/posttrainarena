+"""Error reporting must not change the trainer's existing recovery decisions."""
+import unittest
+from unittest.mock import AsyncMock, Mock, patch
+
+from posttrain_infra.lifecycle import InfrastructureFailure
+from posttrain_infra.runtime import TransportError
+from posttrain_infra.trainer import GroupFailed, RunClient, play_until_verified
+
+
+class TrainerAlertTests(unittest.TestCase):
+    def client(self):
+        client = RunClient("https://controller.example", "run-id", "test-run-token", outage_s=120)
+        client.call = Mock(return_value={})
+        return client
+
+    def failure(self):
+        failure = GroupFailed({"epoch": 7}, [], InfrastructureFailure("Sandbox shutdown timed out"))
+        failure.settle = AsyncMock()
+        return failure
+
+    def test_reports_original_error_before_cleanup_then_uses_existing_retry(self):
+        client, failure = self.client(), self.failure()
+        order = []
+        failure.settle.side_effect = lambda: order.append("cleanup")
+        client.call.side_effect = lambda *args, **kwargs: order.append("retry")
+        with patch("posttrain_infra.trainer.request_json", side_effect=lambda *args, **kwargs: order.append("report")) as report:
+            self.assertEqual(play_until_verified(Mock(side_effect=[failure, {"ok": True}]), client), {"ok": True})
+        self.assertEqual(order, ["report", "cleanup", "retry"])
+        report.assert_called_once_with("https://controller.example", "/internal/runs/run-id/rollout-error",
+            {"epoch": 7, "error": "InfrastructureFailure: Sandbox shutdown timed out"},
+            token="test-run-token", timeout=5)
+        client.call.assert_called_once_with("retry", {"epoch": 7, "error": str(failure)})
+
+    def test_refused_error_report_is_one_bounded_request_without_outage_retries(self):
+        client, failure = self.client(), self.failure()
+        error = TransportError("Connection refused")
+        error.__cause__ = ConnectionRefusedError()
+        with patch("posttrain_infra.trainer.request_json", side_effect=error) as report, \
+                patch("posttrain_infra.trainer.time.sleep") as sleep:
+            self.assertEqual(play_until_verified(Mock(side_effect=[failure, {"ok": True}]), client), {"ok": True})
+        report.assert_called_once()
+        self.assertEqual(report.call_args.kwargs["timeout"], 5)
+        sleep.assert_not_called()
+        failure.settle.assert_awaited_once()
+        client.call.assert_called_once()
+
+    def test_report_precedes_cleanup_failure_without_adding_a_retry(self):
+        client, failure = self.client(), self.failure()
+        failure.settle.side_effect = InfrastructureFailure("Cleanup acknowledgement expired")
+        with patch("posttrain_infra.trainer.request_json", return_value={}) as report:
+            with self.assertRaisesRegex(InfrastructureFailure, "Cleanup acknowledgement expired"):
+                play_until_verified(Mock(side_effect=failure), client)
+        self.assertIn("Sandbox shutdown timed out", report.call_args.args[2]["error"])
+        client.call.assert_not_called()
+
+    def test_reporting_redacts_and_bounds_error_payload(self):
+        client = self.client()
+        with patch("posttrain_infra.trainer.request_json", return_value={}) as report:
+            client.report_group_error(7, "hf_abcdefghijklmnop Bearer abcdefghijklmnop\n" + "x" * 2000)
+        message = report.call_args.args[2]["error"]
+        self.assertNotIn("abcdefghijklmnop", message)
+        self.assertIn("<redacted>", message)
+        self.assertLessEqual(len(message), 1000)
+        self.assertNotIn("\n", message)
+
+
+if __name__ == "__main__":
+    unittest.main()
