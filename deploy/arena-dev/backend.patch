+"""Explicit development-only CPU simulation for exercising submission status and Trackio.
+
+No model, submitted code, image, dataset, Sandbox, or GPU is loaded. Metrics are synthetic.
+It can also run directly: python -m posttrain_infra.cpu_dummy --settings /path/to/trackio.json.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from pathlib import Path
+import re
+import time
+
+from .contracts import claimed_source, parse_dataset_name
+from .dashboard import Dashboard
+
+
+def settings(config: dict) -> dict | None:
+    value = config.get("dev_cpu_dummy")
+    if value is None:
+        return None
+    if config.get("deployment") != "dev" or type(value) is not dict or set(value) - {"steps", "step_seconds"}:
+        raise ValueError("dev_cpu_dummy requires deployment=dev and {steps, step_seconds}")
+    value = {"steps": 8, "step_seconds": 1.0, **value}
+    if type(value["steps"]) is not int or not 1 <= value["steps"] <= 100:
+        raise ValueError("dev_cpu_dummy.steps must be in [1, 100]")
+    if (type(value["step_seconds"]) not in (int, float) or not math.isfinite(value["step_seconds"])
+            or not 0 <= value["step_seconds"] <= 10):
+        raise ValueError("dev_cpu_dummy.step_seconds must be in [0, 10]")
+    return value
+
+
+def prepare_form(value: dict, request_digest: str) -> dict:
+    """Store the submitted form truthfully as unverified; never invent image or dataset pins."""
+    from .submission import task_images
+    references = task_images(value)
+    identifier, name = value.get("submission_id"), value.get("name")
+    if type(identifier) is not str or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", identifier):
+        raise ValueError("submission_id must be a bounded identifier")
+    if type(name) is not str or not 1 <= len(name) <= 256 or any(not char.isprintable() for char in name):
+        raise ValueError("name must contain 1 to 256 printable characters")
+    schema, actions = value.get("schema"), value.get("example_actions")
+    if type(schema) is not dict or any(type(schema.get(key)) is not dict for key in ("action", "observation")):
+        raise ValueError("A submission needs action and observation schema objects")
+    if type(actions) is not list or not actions or any(type(action) is not dict for action in actions):
+        raise ValueError("A submission needs an example_actions list")
+    spec = {"submission_id": identifier, "name": name, "request_digest": request_digest, "simulated": True,
+            "images": [{"submitted_image": reference} for reference in dict.fromkeys(references)],
+            "tasks": [{**task, "image": reference} for task, reference in zip(value["tasks"], references)]}
+    if "source" in value:
+        spec["source"] = claimed_source(value["source"])
+    if "dataset" in value:
+        spec["dataset"] = {"repo": parse_dataset_name(value["dataset"]), "revision": None}
+    return spec
+
+
+def simulate(dashboard: Dashboard, *, steps: int, step_seconds: float, start_step: int = 0,
+             on_step=None, is_cancelled=lambda: False) -> bool:
+    """Emit synthetic training-shaped metrics on the CPU; return false if cancelled."""
+    for step in range(start_step + 1, steps + 1):
+        if is_cancelled():
+            return False
+        dashboard.begin_step()
+        time.sleep(step_seconds)
+        if is_cancelled():
+            return False
+        progress = step / steps
+        dashboard.note({"step/retries": 0, "step/collection_seconds": 0, "simulation": 1})
+        dashboard.log({"loss": 1.0 / (step + 1), "reward": 0.2 + 0.7 * progress,
+                       "reward_std": 0.2 / math.sqrt(step), "grad_norm": 0.8 / math.sqrt(step),
+                       "completions/mean_length": 64 + 8 * step}, step)
+        if on_step is not None:
+            on_step(step)
+    return True
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Synthetic CPU metrics only; performs no model training")
+    parser.add_argument("--settings", required=True, help="Trackio settings with dedicated ingestion token file")
+    parser.add_argument("--steps", type=int, default=8)
+    parser.add_argument("--step-seconds", type=float, default=1)
+    args = parser.parse_args()
+    options = settings({"deployment": "dev", "dev_cpu_dummy": {"steps": args.steps, "step_seconds": args.step_seconds}})
+    dashboard = Dashboard(json.loads(Path(args.settings).read_text()))
+    dashboard.start({"model": "cpu-dummy-no-model", "recipe": "cpu-dummy-simulation", "num_updates": args.steps})
+    try:
+        simulate(dashboard, **options)
+    finally:
+        dashboard.finish()
+
+
+if __name__ == "__main__":
+    main()
