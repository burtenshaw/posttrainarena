+"""CPU-only coverage of the GPU metrics sender and controller integration."""
+import contextlib
+import io
+import json
+from pathlib import Path
+import shutil
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import AsyncMock, Mock, patch
+from urllib.parse import parse_qs, urlsplit
+
+from posttrain_infra.controller import Controller
+from posttrain_infra.dashboard import Dashboard, read_ingestion_token, valid_url
+from posttrain_infra.state import State
+from posttrain_infra.trainer import GroupFailed, play_until_verified
+
+
+class DashboardTests(unittest.TestCase):
+    def dashboard(self):
+        dashboard = Dashboard(None)
+        dashboard.sender = object()  # Keep rows in memory for deterministic assertions.
+        dashboard.project, dashboard.name = "burtenshaw", "full-arena-run-id"
+        dashboard.config = {"run_id": dashboard.name, "submission_id": "submission"}
+        return dashboard
+
+    def test_step_clock_includes_failed_rollout_retry_and_optimizer(self):
+        dashboard = self.dashboard()
+        clock = [100.0]
+        failure = GroupFailed({"epoch": 0}, [], RuntimeError("failed rollout"))
+        failure.settle = AsyncMock()
+        calls = [0]
+
+        def play():
+            calls[0] += 1
+            clock[0] += 7
+            if calls[0] == 1:
+                raise failure
+            dashboard.note({"step/retries": 1, "step/collection_seconds": 7})
+            return {"verified_score": [1, 0, 1, 0]}
+
+        client = Mock()
+        with patch("posttrain_infra.dashboard.time.monotonic", side_effect=lambda: clock[0]):
+            dashboard.begin_step()
+            play_until_verified(play, client)
+            clock[0] += 3  # Forward/backward and optimizer work after collection.
+            dashboard.log({"loss": 0.25, "reward": 0.5, "reward_std": 0.5, "grad_norm": 0.2,
+                           "completions/mean_length": 25, "invalid": float("nan"), "epoch": "one"}, 1)
+            dashboard.log({"train_runtime": 17}, 1)
+        row, final = dashboard.rows.get_nowait(), dashboard.rows.get_nowait()
+        self.assertEqual(row["metrics"]["step/wall_seconds"], 17)
+        self.assertEqual(row["metrics"]["step/retries"], 1)
+        self.assertEqual(row["metrics"]["step/collection_seconds"], 7)
+        self.assertEqual(row["metrics"]["completions/mean_length"], 25)
+        self.assertNotIn("invalid", row["metrics"])
+        self.assertNotIn("epoch", row["metrics"])
+        self.assertNotIn("step/wall_seconds", final["metrics"])
+        self.assertNotEqual(row["log_id"], final["log_id"])
+        self.assertEqual(row["run"], row["run_id"])
+        failure.settle.assert_awaited_once()
+        client.call.assert_called_once_with("retry", {"epoch": 0, "error": "RuntimeError: failed rollout"})
+
+    def test_ingestion_credential_only_in_authorization_header(self):
+        dashboard = self.dashboard()
+        dashboard.token, dashboard.endpoint = "dedicated-ingestion-secret", "https://metrics.hf.space/ingest"
+        dashboard.log({"loss": 0.2}, 2)
+        entry = dashboard.rows.get_nowait()
+        reply = Mock()
+        reply.__enter__ = Mock(return_value=reply)
+        reply.__exit__ = Mock(return_value=False)
+        reply.read.return_value = b'{"ok":true}'
+        with patch("posttrain_infra.dashboard.urllib.request.urlopen", return_value=reply) as post:
+            dashboard._post([entry])
+        request = post.call_args.args[0]
+        self.assertEqual(request.full_url, dashboard.endpoint)
+        self.assertEqual(request.get_header("Authorization"), "Bearer dedicated-ingestion-secret")
+        self.assertEqual(json.loads(request.data), {"logs": [entry]})
+        self.assertNotIn(dashboard.token.encode(), request.data)
+        self.assertNotIn(b"hf_token", request.data)
+
+    def test_http_retry_reuses_event_and_suppresses_secret_in_errors(self):
+        dashboard = self.dashboard()
+        dashboard.log({"loss": 0.2}, 2)
+        dashboard.rows.put(None)
+        with patch.object(dashboard, "_post", side_effect=RuntimeError("secret-value")) as post, \
+                patch("posttrain_infra.dashboard.time.sleep"), contextlib.redirect_stdout(io.StringIO()) as output:
+            dashboard._send()
+        self.assertEqual(post.call_count, 3)
+        self.assertEqual(post.call_args_list[0], post.call_args_list[2])
+        self.assertNotIn("secret-value", output.getvalue())
+        self.assertIn("training continues", output.getvalue())
+
+    def test_hf_credentials_and_invalid_settings_never_start_sender(self):
+        with tempfile.TemporaryDirectory() as directory:
+            token = Path(directory) / "token"
+            for value in ("hf_not-a-dashboard-credential", "", "token\nheader"):
+                token.write_text(value)
+                with self.assertRaises(ValueError):
+                    read_ingestion_token(str(token))
+                dashboard = Dashboard({"url": "https://metrics.hf.space", "token_file": str(token),
+                                       "project": "burtenshaw", "name": "full-run-id"})
+                with contextlib.redirect_stdout(io.StringIO()) as output:
+                    dashboard.start({})
+                self.assertIsNone(dashboard.sender)
+                if value:
+                    self.assertNotIn(value, output.getvalue())
+        for value in ("http://metrics.hf.space", "https://secret@metrics.hf.space", "https://", "https://host/?token=x"):
+            self.assertFalse(valid_url(value))
+
+    def test_disabled_dashboard_does_not_affect_training(self):
+        dashboard = Dashboard(None)
+        dashboard.start({})
+        dashboard.begin_step()
+        dashboard.note({"step/retries": 0})
+        dashboard.log({"loss": 0.1}, 1)
+        dashboard.finish()
+        self.assertTrue(dashboard.rows.empty())
+
+    def test_unsupported_numbers_do_not_interrupt_optimizer_logging(self):
+        dashboard = self.dashboard()
+        dashboard.log({"loss": 0.25, "huge_int": 10 ** 1000, "too_large": 2 ** 63,
+                       "too_small": -(2 ** 63) - 1, "boolean": True, "infinity": float("inf"),
+                       "maximum": 2 ** 63 - 1, "minimum": -(2 ** 63)}, 1)
+        self.assertEqual(dashboard.rows.get_nowait()["metrics"],
+                         {"loss": 0.25, "maximum": 2 ** 63 - 1, "minimum": -(2 ** 63)})
+
+
+class ControllerTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.secret = self.root / "ingest-token"
+        self.secret.write_text("dedicated-ingestion-secret")
+        self.config = {"slurm": {"partition": "gpu", "gpu_type": "h200", "shared_directory": str(self.root)},
+                       "controller_url": "https://controller.example", "trackio": {
+                           "url": "https://metrics.hf.space", "token_file": str(self.secret), "project": "legacy"}}
+        self.state = State(str(self.root / "state.sqlite"))
+
+    def controller(self, **settings):
+        controller = Controller(self.state, {**self.config, **settings})
+        self.addCleanup(controller.validation_executor.shutdown)
+        self.addCleanup(controller.run_executor.shutdown)
+        return controller
+
+    def stage(self, controller, owner="space:burtenshaw"):
+        record, token = self.state.create_run({"submission_id": "same-submission"}, "slurm", owner)
+        submission = SimpleNamespace(submission_id="same-submission", to_dict=lambda: {"submission_id": "same-submission"})
+        stage = controller._slurm_stage(record, submission, token)
+        return record, stage
+
+    def test_per_user_project_full_run_ids_and_durable_links(self):
+        controller = self.controller()
+        first, stage = self.stage(controller)
+        second, _ = self.stage(controller)
+        other, _ = self.stage(controller, "space:another-user")
+        settings = json.loads((stage / "trackio.json").read_text())
+        self.assertEqual(settings["project"], "burtenshaw")
+        self.assertEqual(settings["name"], first["run_id"])
+        self.assertEqual(settings["config"]["run_id"], first["run_id"])
+        self.assertEqual((stage / "trackio-token").stat().st_mode & 0o777, 0o600)
+        shutil.rmtree(self.root / "runs")
+        for record, expected_project in ((first, "burtenshaw"), (second, "burtenshaw"), (other, "another-user")):
+            query = parse_qs(urlsplit(controller.dashboard_link(record["owner"], "same-submission", record["run_id"])).query)
+            self.assertEqual(query, {"project": [expected_project], "runs": [record["run_id"]]})
+        self.assertNotEqual(first["run_id"], second["run_id"])
