+            submitted = self.state.submission(submission_id)
+            if submitted["spec"].get("simulated") is not True or submitted["owner"] != owner:
+                raise ValueError("CPU simulation requires an owned dummy submission")
+            options = self.dev_cpu_dummy
+            request = {"submission_id": submission_id, "request_id": submission_id, "num_updates": options["steps"],
+                       "step_seconds": options["step_seconds"], "recipe": "cpu-dummy-simulation", "gpus": 0}
+            started = existing_run_id or (submitted.get("run") or {}).get("run_id")
+            record = self.state.run(started) if started else self.state.find_request(request, owner)
+            if record is None:
+                record, _ = self.state.create_run(request, "cpu-dummy", owner, budget_s=options["steps"] * 10 + 120)
+            run_id = record["run_id"]
+            if record["state"] in ("completed", "cancelled", "failed"):
+                self.state.settle_run(submission_id, run_id=run_id)
+                return
+            options = {"steps": record["spec"]["num_updates"], "step_seconds": record["spec"]["step_seconds"]}
+            identity = record.get("trackio") or (self._new_dashboard_identity(owner, run_id) if self.dashboard else None)
