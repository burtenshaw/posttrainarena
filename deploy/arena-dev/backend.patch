+        self.token = self.root / "ingest-token"
+        self.token.write_text("dedicated-test-ingestion-token")
+        self.config = {"deployment": "dev", "dev_cpu_dummy": {"steps": 3, "step_seconds": 0},
+                       "slurm": {"partition": "main", "gpu_type": "nvidia_h200"},
+                       "submission_quota_exempt_subjects": ["space:burtenshaw"],
+                       "trackio": {"url": "https://metrics.hf.space", "token_file": str(self.token)},
+                       "transfer_directory": str(self.root / "transfers")}
+        self.state = State(str(self.root / "state.db"))
+        self.controller = self.new_controller()
+        self.rows = []
+        self.capture = patch.object(Dashboard, "_post", side_effect=lambda batch: self.rows.extend(copy.deepcopy(batch)))
+        self.capture.start()
+        self.addCleanup(self.capture.stop)
+        for target in ("posttrain_infra.submission.resolve_image", "posttrain_infra.submission.resolve_dataset",
+                       "posttrain_infra.controller.Controller._hf_gateway",
+                       "posttrain_infra.controller.Controller._reconcile_slurm_run",
+                       "posttrain_infra.slurm.SlurmAdapter.submit", "posttrain_infra.slurm.SlurmAdapter.probe_worker"):
+            blocked = patch(target, side_effect=AssertionError("CPU mode called external infrastructure"))
+            blocked.start()
+            self.addCleanup(blocked.stop)
+
+    def new_controller(self):
+        controller = Controller(self.state, self.config)
+        self.addCleanup(controller.validation_executor.shutdown)
+        self.addCleanup(controller.run_executor.shutdown)
+        return controller
+
+    def form(self, identifier):
+        form = json.loads(FIXTURE.read_text())
+        form["submission_id"] = identifier
+        return form
+
+    def complete(self):
+        self.controller.reconcile()
+        self.controller.run_start.result(timeout=5)
+
+    def test_multiple_submissions_emit_distinct_complete_simulations_in_user_project(self):
+        for identifier in ("cpu-first", "cpu-second"):
+            accepted = self.controller.submit(self.form(identifier), owner="space:burtenshaw")
+            self.assertTrue(accepted["simulated"])
+            self.assertTrue(accepted["run"]["simulated"])
+            self.assertFalse(accepted["report"]["admissible"])
+            self.assertIsNone(accepted["images"][0]["resolved"])
+            self.complete()
+        submissions = self.controller.list_submissions("space:burtenshaw")
+        ids = {item["run"]["run_id"] for item in submissions}
+        self.assertEqual(len(ids), 2)
+        self.assertEqual(len(self.rows), 6)
+        self.assertEqual({row["run_id"] for row in self.rows}, ids)
+        for item in submissions:
+            run = item["run"]
+            self.assertEqual(run["state"], "completed")
+            self.assertEqual(run["policy_version"], 3)
+            self.assertTrue(item["simulated"] and run["simulated"])
+            self.assertEqual(parse_qs(urlsplit(run["dashboard"]).query),
+                             {"project": ["burtenshaw"], "runs": [run["run_id"]]})
+            stored = self.state.run(run["run_id"])
+            self.assertEqual(stored["node"], "cpu-dummy")
+            self.assertEqual(stored["resources"], {"cpu_dummy": True, "gpus": 0})
+            self.assertIsNone(stored["checkpoint"])
+            self.assertNotIn("slurm_job_id", stored)
+        for row in self.rows:
+            self.assertEqual(row["project"], "burtenshaw")
+            self.assertEqual(row["run"], row["run_id"])
+            self.assertEqual(row["config"]["recipe"], "cpu-dummy-simulation")
+            self.assertEqual(row["metrics"]["simulation"], 1)
+            self.assertIn("step/wall_seconds", row["metrics"])
+
+    def test_real_quota_and_owner_checks_still_apply(self):
+        self.controller.submit(self.form("limited"), owner="space:another-user")
+        with self.assertRaises(errors.ArenaError) as raised:
+            self.controller.submit(self.form("limited-again"), owner="space:another-user")
+        self.assertEqual(raised.exception.code, errors.SUBMISSION_QUOTA_EXCEEDED)
+        with self.assertRaises(PermissionError):
+            self.controller.submit(self.form("limited"), owner="space:burtenshaw")
+        self.assertEqual(self.controller.list_submissions("space:burtenshaw"), [])
+        with self.assertRaises(errors.ArenaError):
+            self.controller.create_run({}, owner="local")
+
+    def test_idempotent_submission_and_conflicting_content(self):
+        form = self.form("repeat")
+        self.controller.submit(form, owner="space:burtenshaw")
+        self.complete()
+        first = self.state.submission("repeat")["run"]["run_id"]
+        result = self.controller.submit(form, owner="space:burtenshaw")
+        self.assertEqual(result["run"]["run_id"], first)
+        self.assertEqual(len(self.rows), 3)
+        form["name"] = "different"
+        with self.assertRaises(errors.ArenaError) as raised:
+            self.controller.submit(form, owner="space:burtenshaw")
+        self.assertEqual(raised.exception.code, errors.SUBMISSION_CONFLICT)
+
+    def test_cancellation_in_create_start_gap_cannot_be_resurrected(self):
+        self.controller.submit(self.form("cancel-start"), owner="space:burtenshaw")
+        original = self.state.update
+
+        def cancel_before_start(identifier, change, *, event=None):
+            if event == "cpu_dummy_started":
+                self.controller.cancel(identifier)
+            return original(identifier, change, event=event)
+
+        with patch.object(self.state, "update", side_effect=cancel_before_start):
+            self.complete()
+        run = self.controller.list_submissions("space:burtenshaw")[0]["run"]
+        self.assertEqual(run["state"], "cancelled")
+        self.assertEqual(run["policy_version"], 0)
+        self.assertEqual(self.rows, [])
+
+    def test_restart_continues_only_unfinished_cpu_steps(self):
+        self.controller.submit(self.form("restart"), owner="space:burtenshaw")
+        request = {"submission_id": "restart", "request_id": "restart", "num_updates": 3,
+                   "step_seconds": 0, "recipe": "cpu-dummy-simulation", "gpus": 0}
+        run, _ = self.state.create_run(request, "cpu-dummy", "space:burtenshaw")
+        # Model the crash before simulated is stamped, then after two durable steps.
+        self.state.update(run["run_id"], lambda current: current.update(policy_version=2))
+        # The run-to-submission link has not yet committed either.
+        self.config["dev_cpu_dummy"]["steps"] = 8
+        self.controller = self.new_controller()
+        self.complete()
+        self.assertEqual(self.state.run(run["run_id"])["state"], "completed")
+        self.assertEqual([row["step"] for row in self.rows], [3])
+
+    def test_mode_requires_explicit_dev_gate(self):
+        with self.assertRaises(ValueError):
+            settings({"dev_cpu_dummy": {"steps": 3}})
+        with self.assertRaises(ValueError):
+            settings({"deployment": "production", "dev_cpu_dummy": {}})
+        self.assertIsNone(settings({}))
+
+    def test_submission_http_requires_auth_and_uses_verified_delegate_subject(self):
+        delegate = "test-delegate-token"
+        self.controller.config["client_tokens"] = {
+            hashlib.sha256(delegate.encode()).hexdigest(): {"subject": "space", "roles": ["delegate"]}}
+        server = create_server(self.controller, host="127.0.0.1", port=0, api_token="test-admin-token")
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        base = f"http://127.0.0.1:{server.server_address[1]}"
+        payload = json.dumps(self.form("http-test")).encode()
+        try:
+            with self.assertRaises(HTTPError) as raised:
+                urlopen(Request(base + "/submissions", data=payload,
+                                headers={"Content-Type": "application/json"}), timeout=2)
+            with raised.exception as response:
+                self.assertEqual(response.code, 401)
+            request = Request(base + "/submissions", data=payload, headers={"Content-Type": "application/json",
+                "Authorization": "Bearer " + delegate, "X-Arena-Subject": "burtenshaw"})
+            with urlopen(request, timeout=2) as response:
+                accepted = json.load(response)
+                self.assertEqual(response.status, 202)
+                self.assertEqual(accepted["owner"], "space:burtenshaw")
+            self.complete()
+            self.assertEqual(self.rows[0]["project"], "burtenshaw")
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join(timeout=2)
+
+
+if __name__ == "__main__":
+    unittest.main()
