+from urllib.error import HTTPError
+
+from posttrain_infra import errors
+from posttrain_infra.controller import Controller
+from posttrain_infra.hf_sessions import ManagedHFSessions, deployment_role
+from posttrain_infra.server import create_server
+from posttrain_infra.state import State
+
+
+class DeploymentIsolationTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.api = Mock()
+
+    def manager(self, deployment=None):
+        return ManagedHFSessions(str(Path(self.temporary.name) / "ledger.sqlite"), "a" * 32, 10,
+                                 namespace="openenvarena", jobs_api_factory=lambda: self.api, deployment=deployment)
+
+    def test_dev_sweeper_only_cancels_its_overdue_jobs_even_with_unfiltered_reply(self):
+        manager = self.manager("dev")
+        self.api.list_jobs.return_value = [
+            SimpleNamespace(id="dev-expired", labels={"posttrain-role": "native-openenv-dev", "posttrain-deadline": "10"}),
+            SimpleNamespace(id="dev-live", labels={"posttrain-role": "native-openenv-dev", "posttrain-deadline": "30"}),
+            SimpleNamespace(id="prod-expired", labels={"posttrain-role": "native-openenv", "posttrain-deadline": "10"}),
+            SimpleNamespace(id="another-dev", labels={"posttrain-role": "native-openenv-dev2", "posttrain-deadline": "10"}),
+            SimpleNamespace(id="unlabelled", labels=None),
+            SimpleNamespace(id="invalid-deadline", labels={"posttrain-role": "native-openenv-dev", "posttrain-deadline": "?"}),
+        ]
+        self.assertEqual(manager.sweep(now=20), 1)
+        self.api.list_jobs.assert_called_once_with(namespace="openenvarena", status="RUNNING",
+            labels={"posttrain-role": "native-openenv-dev"}, token=None, timeout=10)
+        self.api.cancel_job.assert_called_once_with(job_id="dev-expired", namespace="openenvarena", token=None)
+
+    def test_default_sweeper_preserves_production_role(self):
+        manager = self.manager()
+        self.api.list_jobs.return_value = [
+            SimpleNamespace(id="dev-expired", labels={"posttrain-role": "native-openenv-dev", "posttrain-deadline": "10"}),
+            SimpleNamespace(id="prod-expired", labels={"posttrain-role": "native-openenv", "posttrain-deadline": "10"}),
+        ]
+        self.assertEqual(manager.sweep(now=20), 1)
+        self.assertEqual(manager.role, "native-openenv")
+        self.api.cancel_job.assert_called_once_with(job_id="prod-expired", namespace="openenvarena", token=None)
+
+    def test_intent_recovery_filters_by_deployment_and_allocation(self):
+        manager = self.manager("dev")
+        manager.ledger = Mock()
+        manager._connect_sandbox = Mock(return_value=Mock())
+        manager._observe_terminal = Mock(return_value=True)
+        self.api.list_jobs.return_value = [
+            SimpleNamespace(id="prod", labels={"posttrain-role": "native-openenv", "posttrain-allocation": "nonce"}),
+            SimpleNamespace(id="unrelated-dev", labels={"posttrain-role": "native-openenv-dev", "posttrain-allocation": "other"}),
+            SimpleNamespace(id="dev", labels={"posttrain-role": "native-openenv-dev", "posttrain-allocation": "nonce"}),
+        ]
+        manager._recover_row({"nonce": "nonce", "sandbox_id": None, "namespace": "openenvarena",
+                              "state": "creating", "updated_at": 0})
+        manager._connect_sandbox.assert_called_once_with("dev", "openenvarena")
+        manager.ledger.record_created.assert_called_once_with("nonce", "dev")
+
+    def test_invalid_deployment_rejected_before_opening_ledger(self):
+        for value in ("", "../prod", "DEV", "a" * 33, False, 1):
+            with self.assertRaises(ValueError):
+                deployment_role(value)
+        self.assertEqual(deployment_role("dev"), "native-openenv-dev")
+
+
+class SubmissionReadinessTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.state = State(str(self.root / "controller.sqlite"))
+        config = {"slurm": {"partition": "main", "gpu_type": "nvidia_h200"},
+                  "submissions_enabled": False, "transfer_directory": str(self.root / "transfers")}
+        self.controller = Controller(self.state, config)
+        self.addCleanup(self.controller.validation_executor.shutdown)
+        self.addCleanup(self.controller.run_executor.shutdown)
+
+    def test_pause_precedes_registry_calls_quota_and_persistence(self):
+        with patch("posttrain_infra.submission.prepare_submission") as prepare, \
+                patch.object(self.state, "save_submission") as save, \
+                patch.object(self.state, "slot_block") as quota:
+            with self.assertRaises(errors.ArenaInfrastructureError) as raised:
+                self.controller.submit({"submission_id": "dev-check"}, owner="space:burtenshaw")
+        self.assertEqual(raised.exception.code, errors.CAPACITY_BUSY)
+        self.assertEqual(raised.exception.status, 503)
+        self.assertEqual(raised.exception.retry_after_s, 60)
+        prepare.assert_not_called()
+        save.assert_not_called()
+        quota.assert_not_called()
+        self.assertEqual(self.controller.list_submissions("space:burtenshaw"), [])
+
+    def test_health_and_http_submission_report_readiness(self):
+        server = create_server(self.controller, host="127.0.0.1", port=0, api_token="dev-admin-token")
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        base = f"http://127.0.0.1:{server.server_address[1]}"
+        try:
+            with urlopen(base + "/health", timeout=2) as response:
+                self.assertEqual(json.load(response), {"status": "ok", "submissions_enabled": False})
+            request = Request(base + "/submissions", data=b'{"submission_id":"dev-check"}', method="POST",
+                              headers={"Authorization": "Bearer dev-admin-token", "Content-Type": "application/json"})
+            with self.assertRaises(HTTPError) as raised:
+                urlopen(request, timeout=2)
+            with raised.exception as response:
+                self.assertEqual(response.code, 503)
+                self.assertEqual(response.headers["Retry-After"], "60")
+                self.assertEqual(json.load(response)["code"], errors.CAPACITY_BUSY)
+        finally:
+            server.shutdown()
+            server.server_close()
+            thread.join(timeout=2)
+
+
+if __name__ == "__main__":
+    unittest.main()
