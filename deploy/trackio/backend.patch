+    def test_hf_credential_never_staged_on_gpu(self):
+        self.secret.write_text("hf_do-not-send-this-to-the-gpu")
+        controller = self.controller()
+        with self.assertLogs("posttrain_infra.controller", level="WARNING") as output:
+            _, stage = self.stage(controller)
+        self.assertFalse((stage / "trackio-token").exists())
+        self.assertFalse((stage / "trackio.json").exists())
+        self.assertNotIn("hf_do-not-send", "".join(output.output))
+        self.assertTrue((stage / "trainer.sh").exists())
