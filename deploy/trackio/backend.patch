+    def test_resumed_run_keeps_persisted_identity(self):
+        controller = self.controller()
+        first, _ = self.stage(controller)
+        self.state.save_submission({"submission_id": "same-submission", "images": []}, {}, "validated", "space:burtenshaw")
+        restarted = self.controller()
+        record = self.state.update(first["run_id"], lambda current: current.update(epoch=1))
+        submission = SimpleNamespace(submission_id="same-submission", to_dict=lambda: {"submission_id": "same-submission"})
+        stage = restarted._slurm_stage(record, submission, "new-run-credential")
+        staged = json.loads((stage / "trackio.json").read_text())
+        self.assertEqual(staged["name"], first["run_id"])
+        self.assertEqual(staged["project"], "burtenshaw")
+        self.assertEqual(self.state.run(first["run_id"])["trackio"],
+                         {"url": "https://metrics.hf.space", "project": "burtenshaw", "name": first["run_id"]})
