+            self.assertEqual(dashboard.config, {"participant": "burtenshaw", "submission_id": "submission",
+                "run_id": "full-run-id", "model": "Qwen/Qwen3.5-9B", "recipe": "grpo", "num_updates": 1000})
+
+    def test_http_retry_reuses_event_and_suppresses_secret_in_errors(self):
+        dashboard = self.dashboard()
+        dashboard.log({"loss": 0.2}, 2)
+        dashboard.rows.put(None)
+        with patch.object(dashboard, "_post", side_effect=RuntimeError("secret-value")) as post, \
