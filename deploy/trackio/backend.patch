+            token.write_text("dedicated-ingestion-token")
+            dashboard = Dashboard({"url": "https://metrics.hf.space", "project": "burtenshaw", "name": "full-run-id",
+                "token_file": str(token), "config": {"participant": "burtenshaw", "submission_id": "submission",
