+    def test_project_config_is_optional_for_new_runs(self):
+        config = {key: value for key, value in self.config["trackio"].items() if key != "project"}
+        controller = self.controller(trackio=config)
+        record, stage = self.stage(controller)
+        self.assertEqual(json.loads((stage / "trackio.json").read_text())["project"], "burtenshaw")
+        self.assertIn(record["run_id"], controller.dashboard_link("space:burtenshaw", "same-submission", record["run_id"]))
